# Firebase Web SDK configuration (src/firebase.js)
# Leave these unset to use the live project (vaktlista-d0efd).
# Set them to point the app at a separate test/staging Firebase project.
# Copy this file to .env (local dev) or configure the equivalent as Vercel/
# GitHub Actions environment variables for a staging deployment.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Base URL of the Cloud Functions serving the iCal endpoints (/ical, /icalEmployee/:id).
# Leave unset to use the live functions URL.
# For a staging project, set this to the staging functions URL, e.g.:
#   https://europe-west1-<your-staging-project-id>.cloudfunctions.net
VITE_API_URL=
