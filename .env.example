# Firebase Web SDK configuration (src/firebase.js)
# Leave unset to use the live project (vaktlista-d0efd).
# For a staging project, set VITE_FIREBASE_CONFIG to the full web app config
# from the Firebase console as a single-line JSON string, e.g.:
#   VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"...","measurementId":"..."}
VITE_FIREBASE_CONFIG=

# Optional override of the Cloud Functions base URL for iCal endpoints.
# When unset it is derived automatically from the Firebase project ID
# (https://europe-west1-<projectId>.cloudfunctions.net).
VITE_API_URL=
