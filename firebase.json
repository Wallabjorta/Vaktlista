{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/export/ical",
        "function": {
          "region": ["europe-west1"],
          "functionName": "ical"
        }
      },
      {
        "source": "/api/export/ical/:employeeId",
        "function": {
          "region": ["europe-west1"],
          "functionName": "icalEmployee"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "runtime": "nodejs20",
    "region": ["europe-west1"]
  }
}
