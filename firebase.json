{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/export/ical",
        "function": {
          "functionName": "ical",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/export/ical/:employeeId",
        "function": {
          "functionName": "icalEmployee",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
