{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/export/ical",
        "function": "ical",
        "region": "us-central1"
      },
      {
        "source": "/api/export/ical/:employeeId",
        "function": "icalEmployee",
        "region": "us-central1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "runtime": "nodejs22",
      "source": "functions",
      "codebase": "default"
    }
  ]
}
